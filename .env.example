# MedBuddy Backend Configuration
# Copy this file to `.env` and adjust values for your environment.
# Never commit real secrets to Git. `.env` is gitignored.

APP_NAME=MedBuddy
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
DATA_DIR=./data
CORS_ORIGINS=http://localhost:8501

# Gemini integration (Backend only - Developer 1).
# Frontend must NOT call Gemini directly; it goes through API endpoints.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
